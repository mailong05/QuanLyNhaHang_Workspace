# 1. TỆP TIN HỆ ĐIỀU HÀNH (OS FILES)
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 2. CÔNG CỤ LẬP TRÌNH (IDEs & EDITORS)
# ------------------------------------------
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.sln
*.suo
*.swp
.settings/
.project
.classpath
.factorypath
.apt_generated

# 3. BACKEND (JAVA / SPRING BOOT)
# ------------------------------------------
backend/target/
backend/build/
backend/bin/
*.class
*.jar
*.war
*.ear
*.log
.mvn/wrapper/maven-wrapper.jar

# Bảo mật Backend (Cấu hình cục bộ & Secrets)
application-local.properties
application-dev.properties
application-test.properties
*.jks
*.p12
*.pem

# 4. FRONTEND (NODE.JS / REACT / VITE)
# ------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Bảo mật Frontend (Biến môi trường)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# 5. CACHE & LOGS TẠM (TEMPORARY FILES)
# ------------------------------------------
.eslintcache
*.pyc
__pycache__/
logs/
